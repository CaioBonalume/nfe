<p1:PedidoEnvioRPS xmlns:p1="http://www.prefeitura.sp.gov.br/nfe">
  <Cabecalho Versao="2">
    <CPFCNPJRemetente>
      <CNPJ>{REMETENTE}</CNPJ>
    </CPFCNPJRemetente>
  </Cabecalho>
  <RPS>
    <Assinatura>{HASH_RPS}</Assinatura>
    <ChaveRPS>
      <InscricaoPrestador>{IM}</InscricaoPrestador>
      <SerieRPS>{SERIE_RPS}</SerieRPS>
      <NumeroRPS>{NUMERO_RPS}</NumeroRPS>
    </ChaveRPS>
    <TipoRPS>RPS</TipoRPS>
    <DataEmissao>{DATA_EMISSAO}</DataEmissao>
    <StatusRPS>N</StatusRPS>
    <TributacaoRPS>{TRIBUTACAO_RPS}</TributacaoRPS>
    <ValorDeducoes>{VALOR_DEDUCOES}</ValorDeducoes>
    <ValorPIS>{VALOR_PIS}</ValorPIS>
    <ValorCOFINS>{VALOR_COFINS}</ValorCOFINS>
    <ValorINSS>{VALOR_INSS}</ValorINSS>
    <ValorIR>{VALOR_IR}</ValorIR>
    <ValorCSLL>{VALOR_CSLL}</ValorCSLL>
    <CodigoServico>{COD_SERVICO}</CodigoServico>
    <AliquotaServicos>{ALIQUOTA}</AliquotaServicos>
    <ISSRetido>{ISS}</ISSRetido>
    {CPFCNPJ_TOMADOR}
    {ENDERECO_TOMADOR}
    <Discriminacao>{DISCRIMINACAO}</Discriminacao>
    {VALOR_TOTAL_RECEBIDO}
    <ValorInicialCobrado>{VALOR_INICIAL_COBRADO}</ValorInicialCobrado>
    <ValorIPI>{VALOR_IPI}</ValorIPI>
    <ExigibilidadeSuspensa>{EXIGIBILIDADE_SUSPENSA}</ExigibilidadeSuspensa>
    <PagamentoParceladoAntecipado>{PAGAMENTO_PARCELADO_ANTECIPADO}</PagamentoParceladoAntecipado>
    {NCM_TAG}
    <NBS>{NBS}</NBS>
    <cLocPrestacao>{CLOC_PRESTACAO}</cLocPrestacao>
    <IBSCBS>
      <finNFSe>{FIN_NFSE}</finNFSe>
      <indFinal>{IND_FINAL}</indFinal>
      <cIndOp>{C_IND_OP}</cIndOp>
      <indDest>{IND_DEST}</indDest>
      <valores>
        <trib>
          <gIBSCBS>
            <cClassTrib>{C_CLASS_TRIB}</cClassTrib>
          </gIBSCBS>
        </trib>
      </valores>
    </IBSCBS>
  </RPS>
</p1:PedidoEnvioRPS>

